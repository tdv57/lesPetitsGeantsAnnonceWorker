{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "les-petits-geants-annonce-worker",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-06",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"d1_databases": [
		{
			"binding": "DB_ANNONCE",
			"database_name": "les-petits-geants-annonce",
			"database_id": "21236e5a-795f-4014-9fa6-5db48f4f7f18"
		},
	],
	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
